# All-Tickers SQLite Configuration
# Copy this file to .env and customize the values

# Database Configuration
DB_TYPE=sqlite

# Database Path Options (choose one):
# Option 1: Full path to database file
SQLITE_DATABASE=/path/to/your/ticker_data.db

# Option 2: Directory where database file will be created (database will be named ticker_data.db)
# DB_DIR=/var/lib/all-tickers

# If neither is set, the database will be created in the current working directory

# Server Configuration
PORT=3001
NODE_ENV=development

# Export Configuration
EXPORT_OUTPUT_DIR=./output
EXPORT_PROCESSING_DIR=./processing

# API Configuration
API_RATE_LIMIT=1000
API_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Security - CHANGE THESE IN PRODUCTION!
# ACCESS_CODE: Required to run protected commands (Generate, Validate, Gather, Monitor)
# PROCESS_KILL_CODE: Required to stop/terminate running processes
ACCESS_CODE=007
PROCESS_KILL_CODE=007
